# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Control-plane boundary. Production requires a deployed Worker URL and ADC
# permission for the dedicated control-plane service account to invoke it.
# The server mints a short-lived Google-signed OIDC token with this URL as its
# audience. Firebase ID tokens are never used as service-to-service tokens.
WORKER_URL=http://127.0.0.1:8080
# Local-only test override; never set this in a deployed environment.
WORKER_IDENTITY_TOKEN=
CONTROL_PLANE_SERVICE_ACCOUNT=blessing-control-plane@gen-lang-client-0730128480.iam.gserviceaccount.com
CONTROL_PLANE_ALLOW_UNAUTHENTICATED_LOCAL=false
CONTROL_PLANE_ONLY=false
CONTROL_PLANE_URL=
CONTROL_PLANE_ALLOWED_SERVICE_ACCOUNTS=blessing-release-controller@gen-lang-client-0730128480.iam.gserviceaccount.com
RELEASE_CONTROLLER_SERVICE_ACCOUNT=blessing-release-controller@gen-lang-client-0730128480.iam.gserviceaccount.com

# Operator audit trail backend: firestore (default, durable in the
# operator_audit_events collection) or memory (local dev/tests). A failed
# durable write fails open into a bounded in-memory buffer and logs
# monitor_event=audit_persistence_failed.
AUDIT_BACKEND=firestore
# These are non-secret read-back values used to bind a release candidate to
# the exact Worker revision. They are required on a deployed Control Plane.
WORKER_IMAGE_DIGEST=
WORKER_REVISION=
CLOUD_SQL_PASSWORD_VERSION=
BINANCE_MAINNET_API_KEY_VERSION=
BINANCE_MAINNET_API_SECRET_VERSION=

# Firebase custom claims accepted by the server-side control-plane RBAC:
# viewer < operator < trading_admin. Claims are provisioned by a trusted Admin
# path and are never accepted from browser request bodies.

# BigQuery uses Firebase ID tokens for browser identity; Google OAuth access
# tokens are reserved for Drive/Sheets and are never accepted by this API.
BIGQUERY_REQUIRE_AUTH=true
BIGQUERY_ALLOW_LOCAL_UNAUTHENTICATED=false

# SQL Connect is staged and must be enabled only after migration read-back and
# two-user ownership tests. Rollback is explicit and exclusive with cutover.
VITE_DATA_CONNECT_CUTOVER=false
VITE_DATA_CONNECT_ROLLBACK=false

# -------------------------------------------------------------
# Blessing AI v0.1 Production & Local Environment Configuration
# -------------------------------------------------------------
# Venue Credentials (NEVER commit live secrets)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=
MAINNET_LIVE_APPROVED=false
EXECUTION_MODE=PAPER
MAINNET_RELEASE_APPROVAL_ID=
MAINNET_LAUNCH_POLICY=STAGED_FIRST_ORDER
MAINNET_CONTINUATION_APPROVAL_ID=
MAINNET_MAX_RISK_INCREASING_ORDERS=1
MAINNET_MAX_COLLATERAL=250
MAINNET_PREFLIGHT_MAX_AGE_SEC=60
# Optional absolute path to the separately installed official CLI; required
# before signed read-only CLI checks can receive Testnet credentials.
BINANCE_CLI_PATH=

# Fail-closed first-launch Testnet limits (environment overrides must remain positive)
TESTNET_ALLOWED_SYMBOLS=BTCUSDT
# Exceeding the 100 USDT first-launch Testnet caps requires explicit operator approval.
TESTNET_LIMITS_OVERRIDE_APPROVED=false
TESTNET_MAX_SINGLE_ORDER_NOTIONAL=100
TESTNET_MAX_TOTAL_OPEN_NOTIONAL=100
TESTNET_MAX_OPEN_ORDERS=1
TESTNET_MAX_ACTIVE_EXPOSURE_CHAINS=1
ACCOUNT_SNAPSHOT_MAX_AGE_SEC=30
MAX_MARKET_DATA_AGE_SEC=3
AUTONOMOUS_TESTNET_EXECUTION=false
AUTONOMOUS_TESTNET_SOAK_APPROVED=false
TESTNET_LAUNCH_APPROVED=false
TESTNET_MANUAL_TRIAL_APPROVED=false

# Carry is disabled unless every explicit net-economics input is supplied.
# Rates are decimal fractions (0.0002 = 2 bps); spreads/slippage are bps.
CARRY_MAKER_FEE_RATE=
CARRY_TAKER_FEE_RATE=
CARRY_ENTRY_SPREAD_BPS=
CARRY_EXIT_SPREAD_BPS=
CARRY_ENTRY_SLIPPAGE_BPS=
CARRY_EXIT_SLIPPAGE_BPS=
CARRY_ANNUAL_FINANCING_RATE=
CARRY_FUNDING_INTERVALS_PER_DAY=
CARRY_HOLDING_HORIZON_SEC=

# Database & Messaging Infrastructure
DATABASE_URL=
PERSISTENCE_MODE=OPTIONAL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=blessing_trading
POSTGRES_USER=blessing_worker
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# System & Risk Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
KILL_SWITCH_ACTIVE=false
DEFAULT_MAX_GRID_LEVELS=5
PORTFOLIO_MAX_LEVERAGE=2.0
EMERGENCY_DRAWDOWN_LIMIT_PCT=8.0

# Google Cloud Analytics & SaaS Infrastructure
GCP_PROJECT_ID="gen-lang-client-0730128480"
GCP_REGION="asia-southeast1"
BIGQUERY_PROJECT_ID="gen-lang-client-0730128480"
BIGQUERY_LOCATION="US"
GCS_BUCKET_NAME="blessing-ai-data-gen-lang-client-0730128480"
CLOUD_SQL_INSTANCE="gen-lang-client-0730128480:asia-southeast1:blessing-sql-primary"
CLOUD_SQL_DB="blessing_trading"
CLOUD_SQL_USER="blessing_worker"
SECRET_MANAGER_PROJECT_ID="gen-lang-client-0730128480"
GOOGLE_WORKSPACE_USER="kotorn@gmail.com"
