# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# Blessing AI v0.1 Production & Local Environment Configuration
# -------------------------------------------------------------
# Venue Credentials (NEVER commit live secrets)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Database & Messaging Infrastructure
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=blessing_ai
POSTGRES_USER=blessing_user
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# System & Risk Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
KILL_SWITCH_ACTIVE=false
DEFAULT_MAX_GRID_LEVELS=5
PORTFOLIO_MAX_LEVERAGE=2.0
EMERGENCY_DRAWDOWN_LIMIT_PCT=8.0

# Google Cloud Analytics & SaaS Infrastructure
GCP_PROJECT_ID="gen-lang-client-0730128480"
GCP_REGION="asia-southeast1"
BIGQUERY_PROJECT_ID="gen-lang-client-0730128480"
BIGQUERY_LOCATION="US"
GCS_BUCKET_NAME="blessing-ai-data-gen-lang-client-0730128480"
CLOUD_SQL_INSTANCE="gen-lang-client-0730128480:asia-southeast1:blessing-sql-primary"
CLOUD_SQL_DB="blessing_trading"
CLOUD_SQL_USER="blessing_app"
SECRET_MANAGER_PROJECT_ID="gen-lang-client-0730128480"
GOOGLE_WORKSPACE_USER="kotorn@gmail.com"
