    "alertStrategy": { "autoClose": "3600s" },
    "documentation": {
      "mimeType": "text/markdown",
      "content": "Exchange and durable ledger reconciliation drift or unknown state observed. Require operator reconciliation before any risk increase."
    },
    "enabled": true,
    "userLabels": { "blessing_signal": "reconciliation", "environment": "all" }
  },
  {
    "displayName": "Blessing AI - Daily loss cap breached",
    "combiner": "OR",
