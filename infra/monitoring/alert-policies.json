  },
  {
    "displayName": "Blessing AI - Ambiguous order",
    "combiner": "OR",
    "conditions": [
      {
        "displayName": "Order response requires reconciliation",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_ambiguous_order\" resource.type=\"cloud_run_revision\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "60s",
          "aggregations": [{ "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM" }]
        }
      }
    ],
    "alertStrategy": { "autoClose": "3600s" },
    "documentation": { "mimeType": "text/markdown", "content": "A Binance order response is ambiguous. Do not retry blindly; reconcile using the deterministic client order ID." },
    "enabled": true,
    "userLabels": { "blessing_signal": "ambiguous_order", "environment": "mainnet" }
  },
  {
    "displayName": "Blessing AI - Staged launch violation",
    "combiner": "OR",
    "conditions": [
      {
        "displayName": "First-order staged session violation",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_staged_session_violation\" resource.type=\"cloud_run_revision\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "60s",
          "aggregations": [{ "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM" }]
        }
