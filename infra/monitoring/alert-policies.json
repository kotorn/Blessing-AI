    "alertStrategy": { "autoClose": "3600s" },
    "documentation": { "mimeType": "text/markdown", "content": "AGY queue pressure or lease recovery observed. Inspect get/list/watch state; do not use AGY as an execution authority." },
    "enabled": true,
    "userLabels": { "blessing_signal": "agy_queue", "environment": "all" }
  },
  {
