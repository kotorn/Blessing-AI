[
  {
    "displayName": "Blessing AI - Readiness degraded",
    "combiner": "OR",
    "conditions": [
      {
        "displayName": "Required worker readiness degraded",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_readiness_degraded\" resource.type=\"cloud_run_revision\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "60s",
          "aggregations": [
            {
              "alignmentPeriod": "60s",
              "perSeriesAligner": "ALIGN_RATE",
              "crossSeriesReducer": "REDUCE_SUM"
            }
          ]
        }
      }
    ],
    "alertStrategy": { "autoClose": "3600s" },
    "documentation": {
      "mimeType": "text/markdown",
      "content": "Required worker readiness degraded. Keep Mainnet disarmed and inspect Cloud Run readiness, SQL persistence, and the latest sanitized error."
    },
    "enabled": true,
    "userLabels": { "blessing_signal": "readiness", "environment": "all" }
  },
  {
    "displayName": "Blessing AI - Persistence outbox failure",
    "combiner": "OR",
    "conditions": [
      {
        "displayName": "Outbox write or queue failure",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_outbox_failure\" resource.type=\"cloud_run_revision\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "60s",
          "aggregations": [
            {
              "alignmentPeriod": "60s",
              "perSeriesAligner": "ALIGN_RATE",
              "crossSeriesReducer": "REDUCE_SUM"
            }
          ]
        }
      },
      {
        "displayName": "Outbox queue full",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_outbox_queue_full\" resource.type=\"cloud_run_revision\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "60s",
          "aggregations": [
            {
              "alignmentPeriod": "60s",
              "perSeriesAligner": "ALIGN_RATE",
              "crossSeriesReducer": "REDUCE_SUM"
            }
          ]
        }
      }
    ],
    "alertStrategy": { "autoClose": "3600s" },
    "documentation": {
      "mimeType": "text/markdown",
      "content": "Transactional outbox failure or queue saturation observed. Risk-increasing execution must remain blocked until persistence is durable again."
    },
    "enabled": true,
    "userLabels": { "blessing_signal": "persistence", "environment": "all" }
  },
  {
    "displayName": "Blessing AI - Private stream disconnected",
    "combiner": "OR",
    "conditions": [
      {
        "displayName": "Binance private stream disconnected",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_private_stream_disconnected\" resource.type=\"cloud_run_revision\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "60s",
          "aggregations": [
            {
              "alignmentPeriod": "60s",
              "perSeriesAligner": "ALIGN_RATE",
              "crossSeriesReducer": "REDUCE_SUM"
            }
          ]
        }
      }
    ],
    "alertStrategy": { "autoClose": "3600s" },
    "documentation": {
      "mimeType": "text/markdown",
      "content": "Private stream disconnected. The Worker must block new risk until the stream and reconciliation are verified."
    },
    "enabled": true,
    "userLabels": { "blessing_signal": "private_stream", "environment": "all" }
  },
  {
    "displayName": "Blessing AI - Reconciliation drift",
    "combiner": "OR",
    "conditions": [
      {
        "displayName": "Exchange and ledger state diverged",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_reconciliation_drift\" resource.type=\"cloud_run_revision\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "60s",
          "aggregations": [
            {
              "alignmentPeriod": "60s",
              "perSeriesAligner": "ALIGN_RATE",
              "crossSeriesReducer": "REDUCE_SUM"
