    "documentation": { "mimeType": "text/markdown", "content": "The staged first-order invariant was violated or could not be durably marked. Keep the Worker disarmed and reconcile before release." },
    "enabled": true,
    "userLabels": { "blessing_signal": "staged_session", "environment": "mainnet" }
  },
  {
