      {
        "displayName": "Binance private stream disconnected",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_private_stream_disconnected\" resource.type=\"cloud_run_revision\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "60s",
          "aggregations": [
            {
              "alignmentPeriod": "60s",
              "perSeriesAligner": "ALIGN_RATE",
              "crossSeriesReducer": "REDUCE_SUM"
            }
          ]
        }
      }
    ],
    "alertStrategy": { "autoClose": "3600s" },
    "documentation": {
      "mimeType": "text/markdown",
      "content": "Private stream disconnected. The Worker must block new risk until the stream and reconciliation are verified."
    },
    "enabled": true,
    "userLabels": { "blessing_signal": "private_stream", "environment": "all" }
  },
