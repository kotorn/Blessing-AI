  },
  {
    "displayName": "Blessing AI - AGY queue pressure",
    "combiner": "OR",
    "conditions": [
      {
        "displayName": "Queue depth or lease recovery",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_agy_queue_depth_high\" resource.type=\"global\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "300s",
          "aggregations": [{ "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM" }]
        }
      },
      {
        "displayName": "Lease expired",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_agy_lease_expired\" resource.type=\"global\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "60s",
          "aggregations": [{ "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM" }]
