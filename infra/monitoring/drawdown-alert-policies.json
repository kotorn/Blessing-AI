    "documentation": { "mimeType": "text/markdown", "content": "Mainnet drawdown reached 10% from the durable starting-capital baseline. New grid/risk expansion must remain blocked while reduction paths remain available." },
    "enabled": true,
    "userLabels": { "blessing_signal": "drawdown_no_new_grid", "environment": "mainnet" }
  },
  {
