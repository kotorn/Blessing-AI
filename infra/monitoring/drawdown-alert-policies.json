[
  {
    "displayName": "Blessing AI - Drawdown CAUTION 5%",
    "combiner": "OR",
    "conditions": [
      {
        "displayName": "Mainnet drawdown entered CAUTION",
        "conditionThreshold": {
          "filter": "metric.type=\"logging.googleapis.com/user/blessing_drawdown_caution\" resource.type=\"cloud_run_revision\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0,
          "duration": "0s",
          "aggregations": [{ "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM" }]
        }
      }
    ],
    "alertStrategy": { "autoClose": "3600s" },
    "documentation": { "mimeType": "text/markdown", "content": "Mainnet drawdown reached 5% from the durable starting-capital baseline. CAUTION is active and capital scaling is reduced to 50%. Review exposure and market conditions; this alert does not authorize any trading action." },
    "enabled": true,
    "userLabels": { "blessing_signal": "drawdown_caution", "environment": "mainnet" }
  },
  {
    "displayName": "Blessing AI - Drawdown NO_NEW_GRID 10%",
