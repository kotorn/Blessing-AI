rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kotorn@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    // Entity validation helpers
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('preferredVenue' in data) || (data.preferredVenue in ['binance_global', 'binance_spot']));
    }

    function isValidUserBasket(data) {
      return data.basketId is string && data.basketId.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.instrument is string && data.instrument.size() <= 32 &&
             data.direction in ['LONG', 'SHORT'] &&
             data.state is string && data.state.size() <= 32 &&
             (!('gridDepth' in data) || data.gridDepth is number) &&
             (!('maxGridLevels' in data) || data.maxGridLevels is number) &&
             (!('totalSize' in data) || data.totalSize is number) &&
             (!('averageEntry' in data) || data.averageEntry is number) &&
             (!('netPnl' in data) || data.netPnl is number);
    }

    function isValidRiskSettings(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.maxPortfolioLeverage is number && data.maxPortfolioLeverage >= 0 && data.maxPortfolioLeverage <= 20 &&
             data.emergencyDrawdownPct is number && data.emergencyDrawdownPct >= 0 && data.emergencyDrawdownPct <= 100 &&
             (!('marginStressThresholdPct' in data) || (data.marginStressThresholdPct is number && data.marginStressThresholdPct <= 100)) &&
             (!('killSwitchActive' in data) || data.killSwitchActive is bool);
    }

    function isValidAuditLog(data) {
      return data.logId is string && data.logId.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.action is string && data.action.size() <= 64 &&
             (!('symbol' in data) || (data.symbol is string && data.symbol.size() <= 32)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 1024));
    }

    // -------------------------------------------------------------
    // User Document and Subcollections
    // -------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == request.auth.uid;
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid;
      allow delete: if isAdmin();

      // Baskets subcollection
      match /baskets/{basketId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(basketId) &&
                         isValidUserBasket(incoming()) &&
                         incoming().userId == request.auth.uid;
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(basketId) &&
                         isValidUserBasket(incoming()) &&
                         incoming().userId == existing().userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Risk Settings subcollection
      match /settings/{settingId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(settingId) &&
                         isValidRiskSettings(incoming()) &&
                         incoming().userId == request.auth.uid;
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(settingId) &&
                         isValidRiskSettings(incoming()) &&
                         incoming().userId == existing().userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Audit Logs subcollection
      match /audit_logs/{logId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(logId) &&
                         isValidAuditLog(incoming()) &&
                         incoming().userId == request.auth.uid;
        allow update, delete: if isAdmin(); // Audit logs are tamper-resistant
      }
    }
  }
}
